{
  "swagger": "2.0",
  "info": {
    "title": "eCommerce API",
    "description": "eCommerce Application API Documentation",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": ["http", "https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],

  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Enter: Bearer <access_token>"
    }
  },

  "tags": [
    { "name": "User Auth", "description": "User authentication APIs" },
    { "name": "App User", "description": "User APIs (Protected)" },
    { "name": "Product", "description": "Product APIs (Protected)" },
    {
      "name": "Product Review",
      "description": "Product Review APIs (Protected)"
    },
    { "name": "Category", "description": "Category APIs (Protected)" },
    { "name": "Cart", "description": "Cart APIs (Protected)" },
    { "name": "Address", "description": "Address APIs (Protected)" },
    { "name": "Order", "description": "Order APIs (Protected)" }
