  "paths": {
    "/user-auth/registration": {
      "post": {
        "tags": ["User Auth"],
        "summary": "Create user",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/registration" }
          }
        ],
        "responses": {
          "201": { "description": "User created" },
          "400": { "description": "Validation error" },
          "409": { "description": "User already exists" }
        }
      }
    },

    "/user-auth/login": {
      "post": {
        "tags": ["User Auth"],
        "summary": "Login user",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/login" }
          }
        ],
        "responses": {
          "200": {
            "description": "Tokens generated",
            "schema": { "$ref": "#/definitions/tokenResponse" }
          },
          "401": { "description": "Invalid credentials" }
        }
      }
    },

    "/user-auth/newToken": {
      "post": {
        "tags": ["User Auth"],
        "summary": "Refresh tokens",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/newToken" }
          }
        ],
        "responses": {
          "200": {
            "description": "New tokens generated",
            "schema": { "$ref": "#/definitions/tokenResponse" }
          },
          "403": { "description": "Invalid or expired refresh token" }
        }
      }
    },

    "/app-users/getUser": {
      "get": {
        "tags": ["App User"],
        "summary": "Get user (Protected)",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "User fetched successfully",
            "schema": { "$ref": "#/definitions/userResponse" }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Invalid token" },
          "404": { "description": "User not found" }
        }
      }
    },

    "/products/getProduct": {
      "get": {
        "tags": ["Product"],
        "summary": "Get Products with Pagination & Filters (Protected)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "type": "integer",
            "default": 1,
            "description": "Page number"
          },
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "default": 10,
            "description": "Number of items per page"
          },
          {
            "name": "productName",
            "in": "query",
            "type": "string",
            "description": "Search by product name (partial match allowed)"
          },
          {
            "name": "categoryId",
            "in": "query",
            "type": "string",
            "description": "Filter by category ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Products fetched successfully",
            "schema": { "$ref": "#/definitions/productListResponse" }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Invalid token" }
        }
      }
    },

