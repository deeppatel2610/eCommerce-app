        "username": { "type": "string", "example": "deep1002p" },
        "email": {
          "type": "string",
          "format": "email",
          "example": "deep@example.com"
        },
        "password": {
          "type": "string",
          "format": "password",
          "example": "StrongPass@123"
        }
      }
    },

    "login": {
      "type": "object",
      "required": ["credential", "password"],
      "properties": {
        "credential": {
          "type": "string",
          "example": "deep@example.com"
